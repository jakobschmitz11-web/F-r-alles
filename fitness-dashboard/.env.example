# Pfad zu deinem Obsidian-Vault (Ordner "Fitness/" wird darin angelegt).
# Standard: ./vault (ist selbst ein gültiger Vault, in Obsidian "Ordner als Vault öffnen")
VAULT_PATH=./vault

PORT=8787
# Automatische Synchronisierung alle N Minuten
SYNC_MINUTES=15

# Demo-Daten (60 Tage) erzeugen, solange nichts verbunden ist. 0 = aus
DEMO=1

# --- Fitbit Air / Google Health API (Google Cloud OAuth-Client "Webanwendung") ---
# Redirect-URI in der Google Cloud Console: http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Technogym ---
# Ordner, in den du Exporte (.tcx / .json / .csv) legst; wird automatisch eingelesen
TECHNOGYM_INBOX=./vault/Fitness/Inbox
